# Copy to .env (git-ignored) for local development. Render sets these as environment variables.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public key: safe in the browser (goes into config.js).
SUPABASE_ANON_KEY=
# Secret: server only. Never put it in config.js or commit it.
SUPABASE_SERVICE_ROLE_KEY=
